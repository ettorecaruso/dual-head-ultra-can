# Generated datasets
/data/raw/*
/data/processed/*
!/data/raw/.gitkeep
!/data/processed/.gitkeep

# Heavy run artifacts (models, logs, plots)
/results/**/best_model.keras
/results/**/best_weights.weights.h5
/results/**/logs/*
!/results/**/logs/config_used.yaml
/results/**/plots/*
/figures/*.pdf

